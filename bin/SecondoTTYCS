#!/bin/bash
#
# The build puts the binaries next to this script, and .secondorc does not add
# that directory to the PATH, so look there first. The PATH is the fallback for
# an installed copy, where the two may live apart.
self="${BASH_SOURCE[0]}"
[ -L "$self" ] && self=$(readlink -f -- "$self" 2>/dev/null || echo "$self")
scriptdir=$(cd -- "$(dirname -- "$self")" && pwd)
executable="$scriptdir/SecondoCS"

if [ ! -x "$executable" ]; then
  executable=$(command -v SecondoCS)
fi

if [ ! -x "$executable" ]; then
  echo "Error: SecondoCS found neither in $scriptdir nor on the PATH" >&2
  echo "Build SECONDO first, or set up the environment, e.g. 'source ~/.secondorc'" >&2
  exit 1
fi

VALGRIND_STD_OPTIONS=" --num-callers=25 --suppressions=vgs.txt --error-limit=no --smc-check=all --track-origins=yes"

if [ "$1" == "--valgrind" ]; then
  shift
  runner="valgrind $VALGRIND_STD_OPTIONS $executable"
else 
   if [ "$1" == "--valgrindlc" ]; then
      shift
      runner="valgrind $VALGRIND_STD_OPTIONS --leak-check=full $executable"
   else  
      if [ "$1" == "--profile" ]; then
         shift
         runner="valgrind --tool=callgrind --dump-instr=yes --trace-jump=yes $executable"
      else
         runner=$executable
      fi  
   fi  
fi 

$runner $*
