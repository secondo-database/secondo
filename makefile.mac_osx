#############################################
#
# SECONDO makefile definitions for Mac OSX
#
#############################################

# System dependent default libraries
DEFAULTLIB = -lpthread -lm -ldl -lc++

# In-process symbolization of stack traces, as on Linux. Apple's toolchain does
# not ship libbacktrace, but the Homebrew formula of the same name does, and
# upstream supports Mach-O. secondo-have-lib reports it only when both the
# header and the library are installed, so without the formula this stays off
# and stack traces fall back to backtrace_symbols_fd(): function names, but no
# line numbers.
#
# The full library path goes into DEFAULTLIB rather than -lbacktrace because
# LD_LINK_LIBS (makefile.env) does not carry $(LDFLAGS), so the
# -L$(HOMEBREW_PREFIX)/lib added below never reaches the executable link.
ifndef SECONDO_NO_LIBBACKTRACE
LIBBACKTRACE_LIB := $(call secondo-have-lib,backtrace.h,backtrace)
endif
ifneq ($(LIBBACKTRACE_LIB),)
DEFAULTCCFLAGS += -DSECONDO_HAVE_LIBBACKTRACE
DEFAULTLIB     += $(LIBBACKTRACE_LIB)
endif

# macros for shared library support
ifeq ($(shared),yes)
PICFLAG := -fPIC
OBJEXT := lo
LIBEXT := dylib
LDFLAGS := -bundle -flat_namespace
else
OBJEXT := o
LIBEXT := a
#LDFLAGS := 
#EXEFLAGS := -static
endif

DLLPICFLAG := -fPIC
DLLOBJEXT := lo
DLLEXT := dylib
DLLFLAGS := -dynamiclib -flat_namespace
DLLPREF := lib


DEFAULTCCFLAGS += -I$(HOMEBREW_PREFIX)/include
LDFLAGS += -L$(HOMEBREW_PREFIX)/lib

# Keg-only formulae (readline, jpeg) are NOT symlinked into $(HOMEBREW_PREFIX),
# so their formula prefixes must be added explicitly. These used to be provided
# by the SDK; makefile.detect now derives them from Homebrew.
ifdef SECONDO_READLINE_DIR
DEFAULTCCFLAGS += -I$(SECONDO_READLINE_DIR)/include
LDFLAGS += -L$(SECONDO_READLINE_DIR)/lib
endif
ifdef SECONDO_JPEG_DIR
DEFAULTCCFLAGS += -I$(SECONDO_JPEG_DIR)/include
LDFLAGS += -L$(SECONDO_JPEG_DIR)/lib
endif
# FlexLexer.h must match the flex that generated the C++ scanners; use the
# Homebrew flex header, not the older one from the macOS SDK.
ifdef SECONDO_FLEX_DIR
DEFAULTCCFLAGS += -I$(SECONDO_FLEX_DIR)/include
endif