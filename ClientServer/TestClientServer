#!/bin/bash
#
# Concurrency and lifecycle test for the SECONDO ClientServer stack.
#
# The .test suites exercise the kernel through TestRunner (single user, kernel
# linked in-process). Nothing exercised the client/server path: SecondoMonitor
# forking a SecondoServer per client, the SecondoRegistrar arbitrating database
# access, and the shutdown of that whole process tree. This test does, by
# starting a real SecondoMonitor on a private port and driving N real clients
# (SecondoCS, i.e. the SecondoInterfaceCS path the WebUI and the Java GUI use)
# against it concurrently. Two client workloads run: executable plans, and --
# when the server was built with the optimizer -- the SQL dialect, which each
# server optimizes in-process, so several embedded optimizers run at once. A
# serial phase then covers SQL that is *not* a query: the CREATE/DROP TABLE
# statements the optimizer executes itself, how a rejected query is reported,
# and the "planonly" protocol flag.
#
# Modelled on the former Optimizer/TestOptServer (the retired JPL optimizer
# server's test); this is now the test here that starts a live monitor.
#
# Assertions check the client's exit status *and* its log. Both are needed: the
# exit status catches a failed command file (2) or a failed connect (1), while
# only the log can show that the query actually produced its result rather than
# the session merely connecting successfully.

set -u

buildDir=${SECONDO_BUILD_DIR:-}
if [ -z "$buildDir" ]; then
  echo "Error: SECONDO_BUILD_DIR is not set."
  exit 1
fi

export SECONDO_CONFIG=${SECONDO_CONFIG:-$buildDir/bin/SecondoConfig.ini}
export PATH="$buildDir/bin:$PATH"

# A private port keeps this off 1234, so it does not collide with a developer's
# running Secondo. It also gives the registrar its own socket name
# (SmiProfile::GetUniqueSocketName keys on the port).
SEC_PORT=${SECONDO_CS_TEST_PORT:-12234}
DBNAME=cstest

# 25 concurrent clients -- the workload this test exists for.
#
# Override to stress higher locally:
#   SECONDO_CS_TEST_CLIENTS=50 ./TestClientServer
NCLIENTS=${SECONDO_CS_TEST_CLIENTS:-25}

# Concurrent clients for the SQL (optimizer) phase. Kept lower than NCLIENTS on
# purpose: each SQL client makes its server load an in-process SWI-Prolog and the
# optimizer, so this phase is far heavier (CPU and memory) than the plain-query
# phase above. The point is still concurrency -- N servers optimizing at once --
# just bounded so it does not exhaust a CI runner. Override with
#   SECONDO_CS_TEST_SQL_CLIENTS=25 ./TestClientServer
NSQLCLIENTS=${SECONDO_CS_TEST_SQL_CLIENTS:-10}

home=$(mktemp -d "${TMPDIR:-/tmp}/TestClientServer.XXXXXX")
export SECONDO_PARAM_SecondoHome="$home"
monPid=""
# The second monitor, started with the fault injection flag for phase 3c. Kept
# out here so cleanup can reach it however the test ends.
truncMonPid=""
rc=0

# Run from the temporary home. The TTY binaries drop cwd-relative files
# (.secondo_history, proglogt.csv, temp_nested_list/, tmp/ -- the last two once
# per client process), and run-tests.sh invokes this with cwd=ClientServer/,
# so without this the test litters the source tree. Everything below uses
# absolute paths, and cleanup removes $home.
cd "$home" || exit 1

# Tear the monitor down without ever blocking indefinitely. Every wait here is
# bounded and escalates to SIGKILL: this test exists partly because shutdown is
# unreliable, so the teardown must not assume it works. A bare "wait" would hang
# the whole CI job (timeout 12000s) whenever the monitor fails to exit.
stop_monitor() {
  local target=$1 pid grace kids
  [ -n "$target" ] || return 0

  # Snapshot the tree before signalling; once the monitor is gone we can no
  # longer walk to its children.
  kids=$(descendants "$target")

  # Ask the monitor to shut down first and let it stop its own children, which
  # is the intended path. Only ever target PIDs we started -- a broad
  # "pkill -f Secondo" would kill a developer's unrelated session.
  kill -TERM "$target" 2>/dev/null
  for ((grace = 0; grace < 15; grace++)); do
    kill -0 "$target" 2>/dev/null || break
    sleep 1
  done

  # Escalate to anything still standing, monitor included.
  kill -KILL "$target" 2>/dev/null
  for pid in $kids; do kill -KILL "$pid" 2>/dev/null; done

  # Reap only our monitor; a bare "wait" could block on an unrelated job.
  wait "$target" 2>/dev/null
  return 0
}

cleanup() {
  stop_monitor "$monPid"
  stop_monitor "$truncMonPid"
  rm -rf "$home"
}
# EXIT alone is not enough: bash does not run an EXIT trap when it is killed by
# an *untrapped* signal, which is exactly how run-tests.sh's timeOut helper and
# CI cancellation kill a hung test. Without INT/TERM here, being timed out leaks
# the whole monitor tree.
trap 'cleanup; exit 143' INT TERM
trap cleanup EXIT

# Wait until a TCP port accepts connections (bash /dev/tcp, no extra tools).
wait_port() {
  local port=$1 tries=$2 i
  for ((i = 0; i < tries; i++)); do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      exec 3>&- 3<&-
      return 0
    fi
    sleep 1
  done
  return 1
}

# Full descendant closure of a pid, via one ps snapshot. "ps -ax -o pid=,ppid="
# behaves the same on Linux (procps) and macOS (BSD ps). Used instead of
# "pgrep -g": that needs a known process group, which needs setsid, which does
# not exist as a command on macOS.
descendants() {
  local root=$1
  ps -ax -o pid=,ppid= 2>/dev/null | awk -v root="$root" '
    { ppid[$1] = $2; pids[n++] = $1 }
    END {
      want[root] = 1
      do {
        added = 0
        for (i = 0; i < n; i++) {
          p = pids[i]
          if (!(p in want) && (ppid[p] in want)) { want[p] = 1; added = 1 }
        }
      } while (added)
      for (p in want) if (p != root) print p
    }'
}

# Dump what a wedged process is actually doing. "ps -o stat=" only says it is
# sleeping; the call it is sleeping in is the whole question when a shutdown
# hangs, and the process is about to be SIGKILLed, so this is the last chance to
# ask. Best effort by design: whichever tool exists on the runner is used, and
# if none does, the caller still gets its ps line. sample(1) is present on every
# macOS runner and needs no privileges; on Linux, eu-stack and gdb usually need
# none for a process we own.
dump_backtrace() {
  local pid=$1 label=$2
  echo "=== backtrace of $label (pid $pid) ==="
  # Free and never refused, unlike the debuggers below: on Linux this names the
  # kernel function the process is blocked in, which already separates "waiting
  # on a futex" -- an orphaned Berkeley DB region mutex -- from "waiting on I/O".
  if [ -r "/proc/$pid/wchan" ]; then
    echo "wchan: $(cat "/proc/$pid/wchan" 2>/dev/null)"
  fi
  if command -v sample >/dev/null 2>&1; then
    # 2 seconds at 10ms: enough samples to show a stack that is not moving.
    sample "$pid" 2 10 -mayDie 2>&1 | head -120
  elif command -v eu-stack >/dev/null 2>&1; then
    # Both this and gdb below need ptrace. Under the Ubuntu default
    # (yama/ptrace_scope=1) only an ancestor may trace, and these run as
    # siblings of the target, so the attach may well be refused -- the error
    # goes to the log and wchan above still stands.
    eu-stack -p "$pid" 2>&1 | head -120
  elif command -v gdb >/dev/null 2>&1; then
    gdb -p "$pid" --batch -ex "thread apply all bt" 2>&1 | head -120
  else
    echo "(no sample/eu-stack/gdb available)"
  fi
}

# Assert every pid passed is gone. Used by the shutdown tests in later commits;
# defined here so the helper lands with the harness.
assert_no_orphans() {
  local label=$1; shift
  local leaked="" pid
  for pid in "$@"; do
    if kill -0 "$pid" 2>/dev/null; then leaked="$leaked $pid"; fi
  done
  if [ -n "$leaked" ]; then
    echo "FAIL ($label): processes survived:$leaked"
    ps -p "$(echo "$leaked" | tr ' ' ',' | sed 's/^,//')" -o pid=,ppid=,comm= 2>/dev/null
    return 1
  fi
  echo "OK ($label): no orphans"
  return 0
}

#
# Phase 1: create the test database.
#
echo "*** ClientServer test: creating database '$DBNAME' ***"
SecondoTTYBDB >"$home/db.log" 2>&1 <<SQL
create database $DBNAME;
open database $DBNAME;
let ten = intstream(1,10) transformstream consume;
close database;
q;
SQL
if grep -qiE "cmd failed|command failed|Error in Secondo" "$home/db.log"; then
  echo "FAIL: database setup failed:"; cat "$home/db.log"; exit 1
fi

#
# Phase 2: start the monitor.
#
echo "*** ClientServer test: starting SecondoMonitor on port $SEC_PORT ***"
# The monitor launches its server program from its working directory, so start
# it from bin/. pushd (not a subshell) keeps $monPid the monitor itself, so
# cleanup can reach the children it forks.
pushd "$buildDir/bin" >/dev/null
SecondoMonitor -s -p "$SEC_PORT" >"$home/monitor.log" 2>&1 &
monPid=$!
popd >/dev/null
if ! wait_port "$SEC_PORT" 30; then
  echo "FAIL: monitor did not come up on port $SEC_PORT:"; cat "$home/monitor.log"; exit 1
fi

kids=$(descendants "$monPid" | tr '\n' ' ')
echo "    monitor pid $monPid, children:$kids"

#
# Phase 3: N clients running real queries concurrently.
#
echo "*** ClientServer test: $NCLIENTS parallel clients ***"
declare -a cpid crc
for i in $(seq 1 "$NCLIENTS"); do
  cat >"$home/c$i.sec" <<SQL
open database $DBNAME;
query ten feed count;
close database;
q;
SQL
  SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/c$i.sec" \
    >"$home/c$i.log" 2>&1 &
  cpid[$i]=$!
done

for i in $(seq 1 "$NCLIENTS"); do
  wait "${cpid[$i]}" 2>/dev/null
  crc[$i]=$?
done

# Assert on both the exit status and the log. The log checks are not redundant:
# they prove the query actually produced its result, which an exit status alone
# cannot show.
failed=0
for i in $(seq 1 "$NCLIENTS"); do
  log="$home/c$i.log"
  if [ "${crc[$i]}" -ne 0 ]; then
    echo "FAIL: client $i exited with ${crc[$i]}"
    failed=$((failed + 1))
  elif ! grep -q "successfully processed" "$log" 2>/dev/null; then
    echo "FAIL: client $i did not complete its command file"
    failed=$((failed + 1))
  elif grep -qE "SECONDO-000[0-9]|Error in Secondo|Errors during processing" "$log"; then
    echo "FAIL: client $i reported an error"
    failed=$((failed + 1))
  elif ! grep -qE "^[[:space:]]*10[[:space:]]*$" "$log"; then
    # "query ten feed count" must return 10; proves the query really ran rather
    # than the session merely connecting.
    echo "FAIL: client $i did not return the expected query result"
    failed=$((failed + 1))
  fi
done

if [ "$failed" -gt 0 ]; then
  echo "*** $failed/$NCLIENTS clients failed ***"
  echo "=== first failing client log ==="
  for i in $(seq 1 "$NCLIENTS"); do
    if ! grep -q "successfully processed" "$home/c$i.log" 2>/dev/null; then
      tail -30 "$home/c$i.log"; break
    fi
  done
  echo "=== monitor log ==="
  tail -30 "$home/monitor.log"
  rc=1
else
  echo "OK: $NCLIENTS/$NCLIENTS clients completed successfully"
fi

#
# Phase 3b: the Java client. Everything else here drives SecondoCS, i.e. the
# C++ SecondoInterfaceCS. The Java interface under Javagui/secondoInterface is
# a second, independent implementation of the same client/server protocol --
# the one the Java GUI and every JDBC user go through -- and nothing tested it:
# it is compiled by the top level make (target java2) and no makefile ever ran
# it, so a protocol change could break it silently.
#
# tools.CSTest asserts rather than prints (unlike tools.ExClient, which is why
# ExClient could never be used as a gate); it exits 2 when an assertion failed
# and 1 when it could not connect at all. Its assertions cover the handshake,
# a small and a multi-chunk result, an error, that the connection survives that
# error, and message delivery. The monitor is already up and $DBNAME already
# holds 'ten', so this needs nothing of its own.
#
# SKIP, not FAIL, when java or the compiled test is missing: `make java2` is
# guarded by a javac probe that degrades to a warning, so a developer without a
# JDK has a perfectly good build with no Javagui in it and must not see a red
# test. CI installs a JDK, so there this phase really runs.
#
echo "*** ClientServer test: Java client (tools.CSTest) ***"
javaGui="$buildDir/Javagui"
javaJar="$javaGui/secondoInterface/SecondoInterface.jar"
if ! command -v java >/dev/null 2>&1; then
  echo "SKIP (java): no java runtime on PATH"
elif [ ! -f "$javaJar" ] || [ ! -f "$javaGui/tools/CSTest.class" ]; then
  echo "SKIP (java): Javagui was not compiled (no SecondoInterface.jar or CSTest.class)"
else
  # CSTest takes --expect-binary/--expect-text, and neither is passed here on
  # purpose. Which mode is in force is the monitor's Server:BinaryTransfer
  # flag, and SECONDO_PARAM_RTFlags replaces the config's RTFlags outright
  # rather than adding to it -- run-tests.sh, which is how CI reaches this
  # file, sets it -- so any expectation computed here is a second, subtly
  # different copy of the server's own resolution, and gets it wrong.
  # Tests/csloadtest already asserts the mode against a known configuration.
  # CSTest reports the mode it negotiated; the OK line below repeats it.
  #
  # headless: the interface reports through tools.Reporter, which falls back to
  # a Swing dialog for some messages. On a CI runner that throws rather than
  # blocking, but there is no reason to find out the hard way.
  java -Djava.awt.headless=true \
       -cp "$javaGui:$javaJar" \
       tools.CSTest 127.0.0.1 "$SEC_PORT" "$DBNAME" \
       >"$home/java.log" 2>&1
  javaRc=$?

  # As everywhere here, assert the exit status *and* the log: the status says
  # the assertions held, the log line says they actually ran.
  if [ "$javaRc" -ne 0 ]; then
    echo "FAIL (java): tools.CSTest exited with $javaRc"
    grep -n "^FAIL" "$home/java.log" | head -10
    tail -30 "$home/java.log"
    rc=1
  elif ! grep -q "^successful$" "$home/java.log"; then
    echo "FAIL (java): tools.CSTest did not run to completion"
    tail -30 "$home/java.log"
    rc=1
  else
    echo "OK (java): $(grep -c "^ok   :" "$home/java.log") assertions held," \
         "$(sed -n 's/^     : //p' "$home/java.log")"
  fi
fi

#
# Phase 3c: an error detected *after* the result started going out.
#
# This is the one case the <SecondoResult> framing exists for: the server has
# already written part of a result -- including a length prefix promising N
# tuples -- when it discovers it cannot finish. Before the framing there was no
# way to say so, and the server closed the connection. Now it closes the frame
# with an abort terminator instead, and the client discards the partial payload,
# reports the reason and carries on.
#
# No natural query provokes it: a query either fails before its result exists or
# it succeeds. So the server for this phase is started with the fault injection
# flag Test:TruncateStreamedResult (see Relation::OutStreamed), which stops every
# streamed relation after a few tuples and reports failure.
#
# Its own monitor, port and SecondoHome. The flag is per process, so it cannot
# share the monitor above -- every result there would truncate. A separate home
# rather than a second monitor over the same database: two monitors on different
# ports get different registrar sockets (SmiProfile::GetUniqueSocketName keys on
# the port) and so would not arbitrate access to a shared one at all.
#
# The negative control is phase 3b: the same client, the same two commands,
# against the unflagged monitor, where they succeed. Without it a truncation
# assertion could pass on a server that was broken for some entirely different
# reason.
#
truncPort=$((SEC_PORT + 1))
truncHome="$home/trunc"

# SECONDO_PARAM_RTFlags replaces the config's RTFlags outright rather than
# adding to it, so the flags already in force have to be carried over -- losing
# Server:BinaryTransfer here would make the sink decline, nothing would stream,
# and the test would pass by never exercising the path at all. When the variable
# is unset the config is still the source, so read the active RTFlags lines out
# of it.
truncFlags="${SECONDO_PARAM_RTFlags-}"
if [ -z "$truncFlags" ]; then
  truncFlags=$(sed -n 's/^[[:space:]]*RTFlags[[:space:]]*+\{0,1\}=[[:space:]]*//p' \
                   "$SECONDO_CONFIG" 2>/dev/null | paste -sd, - )
fi
truncFlags="${truncFlags:+$truncFlags,}Test:TruncateStreamedResult"

# And binary transfer has to be on, whatever the rest of the configuration says.
# Only a streamed result can be truncated, and the sink declines in textual mode
# -- so without this the phase quietly degrades to "skipped" and the gate for the
# whole abort path becomes vacuous. That is exactly what happens under
# CM-Scripts/run-tests.sh, which is how CI reaches this file: it sets
# SECONDO_PARAM_RTFlags to a list that does not include Server:BinaryTransfer.
# Forcing it here hides nothing; textual transfer is covered by phase 3b and by
# Tests/csloadtest --expect-text.
case ",$truncFlags," in
  *,Server:BinaryTransfer,*) ;;
  *) truncFlags="$truncFlags,Server:BinaryTransfer" ;;
esac

echo "*** ClientServer test: truncated result (tools.CSTest) ***"
if ! command -v java >/dev/null 2>&1; then
  echo "SKIP (truncation): no java runtime on PATH"
elif [ ! -f "$javaJar" ] || [ ! -f "$javaGui/tools/CSTest.class" ]; then
  echo "SKIP (truncation): Javagui was not compiled"
else
  mkdir -p "$truncHome"
  SECONDO_PARAM_SecondoHome="$truncHome" SecondoTTYBDB \
      >"$home/truncdb.log" 2>&1 <<SQL
create database $DBNAME;
open database $DBNAME;
let ten = intstream(1,10) transformstream consume;
close database;
q;
SQL
  if grep -qiE "cmd failed|command failed|Error in Secondo" "$home/truncdb.log"; then
    echo "FAIL (truncation): database setup failed:"; cat "$home/truncdb.log"
    rc=1
  else
    pushd "$buildDir/bin" >/dev/null
    SECONDO_PARAM_SecondoHome="$truncHome" \
    SECONDO_PARAM_RTFlags="$truncFlags" \
      SecondoMonitor -s -p "$truncPort" >"$home/truncmon.log" 2>&1 &
    truncMonPid=$!
    popd >/dev/null

    if ! wait_port "$truncPort" 30; then
      echo "FAIL (truncation): monitor did not come up on port $truncPort:"
      cat "$home/truncmon.log"
      rc=1
    else
      java -Djava.awt.headless=true \
           -cp "$javaGui:$javaJar" \
           tools.CSTest 127.0.0.1 "$truncPort" "$DBNAME" --expect-truncation \
           >"$home/javatrunc.log" 2>&1
      truncRc=$?
      if [ "$truncRc" -ne 0 ]; then
        echo "FAIL (truncation): tools.CSTest exited with $truncRc"
        grep -n "^FAIL" "$home/javatrunc.log" | head -10
        tail -30 "$home/javatrunc.log"
        rc=1
      elif ! grep -q "^successful$" "$home/javatrunc.log"; then
        echo "FAIL (truncation): tools.CSTest did not run to completion"
        tail -30 "$home/javatrunc.log"
        rc=1
      elif ! grep -q "truncation: reported as error 90" "$home/javatrunc.log"; then
        # Exit 0 is not enough here. CSTest skips the truncation assertions on a
        # textual connection -- nothing streams there, so there is nothing to
        # truncate -- and a skip still exits 0. That is how this phase silently
        # became a no-op once already, when the flags carried over above lost
        # Server:BinaryTransfer. Name the assertion, so only the real thing passes.
        echo "FAIL (truncation): the truncation assertions did not run"
        tail -30 "$home/javatrunc.log"
        rc=1
      else
        echo "OK (truncation): $(grep -c "^ok   :" "$home/javatrunc.log")" \
             "assertions held"
      fi
    fi
    stop_monitor "$truncMonPid"
    truncMonPid=""
  fi
fi

#
# Phase 4: concurrent SQL optimization. The clients above ran executable plans;
# here they send the SQL dialect (command level 2), which the server optimizes
# in-process before executing. Each connection forks its own server, so this
# runs N independent embedded optimizers against the one shared database at
# once -- the concurrency the embedded optimizer must survive.
#
# Skipped, not failed, when the server was built without the optimizer: level 2
# then returns ERR_OPTIMIZER_NOT_AVAILABLE ("... not available on this server").
# A serial probe decides which case we are in before the fan-out, so a genuine
# optimizer regression still fails rather than being mistaken for "not built".
#
echo "*** ClientServer test: SQL optimizer probe ***"
cat >"$home/sqlprobe.sec" <<SQL
open database $DBNAME;
sql select * from ten;
close database;
q;
SQL
SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/sqlprobe.sec" \
  >"$home/sqlprobe.log" 2>&1
probeRc=$?

# Set once the probe has shown the server really optimizes; the DDL phase below
# reuses it instead of probing again.
sqlEnabled=0

if grep -q "not available on this server" "$home/sqlprobe.log"; then
  echo "SKIP: server has no optimizer (non-optimizer build); skipping SQL phase"
elif [ "$probeRc" -ne 0 ] \
     || ! grep -q "successfully processed" "$home/sqlprobe.log" \
     || ! grep -q "Optimized plan:" "$home/sqlprobe.log" \
     || ! grep -q "Elem : 10" "$home/sqlprobe.log"; then
  # The optimizer should be here (no "not available" message) but the probe did
  # not produce an optimized plan and its result -- a real regression.
  echo "FAIL: SQL optimizer probe did not return an optimized result"
  tail -30 "$home/sqlprobe.log"
  rc=1
else
  sqlEnabled=1
  echo "*** ClientServer test: $NSQLCLIENTS parallel SQL (optimizer) clients ***"
  declare -a spid src
  for i in $(seq 1 "$NSQLCLIENTS"); do
    cat >"$home/s$i.sec" <<SQL
open database $DBNAME;
sql select * from ten;
close database;
q;
SQL
    SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/s$i.sec" \
      >"$home/s$i.log" 2>&1 &
    spid[$i]=$!
  done

  for i in $(seq 1 "$NSQLCLIENTS"); do
    wait "${spid[$i]}" 2>/dev/null
    src[$i]=$?
  done

  # As in the plain phase, assert on both exit status and log. "Optimized plan:"
  # proves the server actually optimized the SQL (not just executed a plan the
  # client sent), and "Elem : 10" proves that optimized plan then ran and
  # returned the whole relation.
  sqlFailed=0
  for i in $(seq 1 "$NSQLCLIENTS"); do
    log="$home/s$i.log"
    if [ "${src[$i]}" -ne 0 ]; then
      echo "FAIL: SQL client $i exited with ${src[$i]}"
      sqlFailed=$((sqlFailed + 1))
    elif ! grep -q "successfully processed" "$log" 2>/dev/null; then
      echo "FAIL: SQL client $i did not complete its command file"
      sqlFailed=$((sqlFailed + 1))
    elif grep -qE "SECONDO-000[0-9]|Error in Secondo|Errors during processing|not available on this server" "$log"; then
      echo "FAIL: SQL client $i reported an error"
      sqlFailed=$((sqlFailed + 1))
    elif ! grep -q "Optimized plan:" "$log"; then
      echo "FAIL: SQL client $i did not receive an optimized plan"
      sqlFailed=$((sqlFailed + 1))
    elif ! grep -q "Elem : 10" "$log"; then
      echo "FAIL: SQL client $i did not return the expected query result"
      sqlFailed=$((sqlFailed + 1))
    fi
  done

  if [ "$sqlFailed" -gt 0 ]; then
    echo "*** $sqlFailed/$NSQLCLIENTS SQL clients failed ***"
    echo "=== first failing SQL client log ==="
    for i in $(seq 1 "$NSQLCLIENTS"); do
      if ! grep -q "Optimized plan:" "$home/s$i.log" 2>/dev/null; then
        tail -30 "$home/s$i.log"; break
      fi
    done
    echo "=== monitor log ==="
    tail -30 "$home/monitor.log"
    rc=1
  else
    echo "OK: $NSQLCLIENTS/$NSQLCLIENTS SQL clients optimized and ran concurrently"
  fi
fi

#
# Phase 5: SQL DDL round-trip through the optimizer. Deliberately serial and a
# single client -- the concurrency this test exists for is covered by phase 4;
# what is new here is the *shape* of the commands.
#
# "create table" and "drop table" are not optimized into a plan: the optimizer
# carries them out itself and yields the sentinel "done" instead of a plan
# (sqlToPlan2, Optimizer/optimizerNewProperties.pl), which the client reports as
# "Executed by the optimizer (no plan to run)." Executing "done" as a query
# ("query done") was a real bug, so assert the sentinel is honoured.
#
# The "select count(*)" in between is the point of the phase: it can only be
# optimized if the optimizer re-read the catalog after the CREATE. The server
# caches the schema and returns early when the database is already loaded, so
# without the post-DDL refresh (embeddedOptimizerSqlChangesCatalog /
# embeddedOptimizerRefreshCatalog) the new table is invisible and the
# optimization fails.
#
if [ "$sqlEnabled" -eq 1 ]; then
  echo "*** ClientServer test: SQL DDL round-trip (create/select/drop) ***"
  cat >"$home/sqlddl.sec" <<SQL
open database $DBNAME;
create table tmptab columns [no: int, name: string];
select count(*) from tmptab;
drop table tmptab;
close database;
q;
SQL
  SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/sqlddl.sec" \
    >"$home/sqlddl.log" 2>&1
  ddlRc=$?

  ddlFailed=0
  if [ "$ddlRc" -ne 0 ]; then
    echo "FAIL (ddl): client exited with $ddlRc"
    ddlFailed=1
  elif ! grep -q "successfully processed" "$home/sqlddl.log"; then
    echo "FAIL (ddl): client did not complete its command file"
    ddlFailed=1
  elif grep -qE "SECONDO-000[0-9]|Error in Secondo|Errors during processing|not available on this server" "$home/sqlddl.log"; then
    echo "FAIL (ddl): client reported an error"
    ddlFailed=1
  elif [ "$(grep -c "Executed by the optimizer" "$home/sqlddl.log")" -ne 2 ]; then
    # Once for CREATE TABLE, once for DROP TABLE.
    echo "FAIL (ddl): CREATE/DROP were not reported as executed by the optimizer"
    ddlFailed=1
  elif ! grep -qE "Optimized plan:.*Tmptab.*count" "$home/sqlddl.log"; then
    # The plan must name the freshly created relation -- proof the optimizer's
    # catalog picked the CREATE up.
    echo "FAIL (ddl): SELECT on the new table was not optimized (stale catalog?)"
    ddlFailed=1
  elif ! grep -qE "^[[:space:]]*0[[:space:]]*$" "$home/sqlddl.log"; then
    # "count(*)" on the empty table must return 0, i.e. the plan really ran.
    echo "FAIL (ddl): SELECT did not return the expected count"
    ddlFailed=1
  fi

  if [ "$ddlFailed" -ne 0 ]; then
    tail -40 "$home/sqlddl.log"
    rc=1
  else
    echo "OK (ddl): create table / select / drop table round-trip"
  fi
fi

#
# Phase 6: optimizer error reporting. A query the optimizer must reject has to
# come back as a readable sentence, not as the raw Prolog encoding.
#
# The optimizer reports failures as "::ERROR::" plus the message written back as
# a term (term_to_atom in sqlToPlan/3), i.e. quoted and escaped:
#
#   '\n\nSQL ERROR (usually a user error): Unknown symbol: \'x\' is not ...'
#
# The server decodes that (prologQuotedToPlain, UserInterfaces/SecondoPL.cpp) so
# no client has to. Assert both halves: the sentence is there, and none of the
# encoding survived -- a regression would still "surface an error", just an
# unreadable one, which the presence check alone would not catch.
#
# Unlike the phases above this client is *expected* to fail its command file
# (the rejected query makes the TTY exit non-zero), so only the log is asserted.
#
if [ "$sqlEnabled" -eq 1 ]; then
  echo "*** ClientServer test: optimizer error reporting ***"
  cat >"$home/sqlerr.sec" <<SQL
open database $DBNAME;
select nonexistingattr from ten;
close database;
q;
SQL
  SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/sqlerr.sec" \
    >"$home/sqlerr.log" 2>&1

  errFailed=0
  if ! grep -q "Optimization failed:" "$home/sqlerr.log"; then
    echo "FAIL (error): the rejected query did not report an optimizer error"
    errFailed=1
  elif ! grep -qF "SQL ERROR (usually a user error): Unknown symbol: 'nonexistingattr'" \
                 "$home/sqlerr.log"; then
    echo "FAIL (error): the optimizer error message is not the decoded text"
    errFailed=1
  elif grep "Optimization failed:" "$home/sqlerr.log" | grep -qF '\n'; then
    # A literal backslash-n means the term_to_atom encoding was passed through.
    echo "FAIL (error): the optimizer error message is still Prolog-escaped"
    errFailed=1
  fi

  if [ "$errFailed" -ne 0 ]; then
    grep -n "Optimization failed:" "$home/sqlerr.log" | head -5
    tail -20 "$home/sqlerr.log"
    rc=1
  else
    echo "OK (error): optimizer error reported as plain text"
  fi
fi

#
# Phase 7: plan-only. "optimizer <sql>" sends the same SQL with the "planonly"
# protocol flag, so the server optimizes but does not execute.
#
# The oracle is the *same* query phase 4 runs: there it must produce "Elem : 10"
# (the last tuple of ten), here that output must be absent while the plan is
# still reported. A flag that silently did nothing would pass a plan check
# alone, so the negative assertion is the one that matters.
#
if [ "$sqlEnabled" -eq 1 ]; then
  echo "*** ClientServer test: plan-only (optimizer prefix) ***"
  cat >"$home/sqlplan.sec" <<SQL
open database $DBNAME;
optimizer select * from ten;
close database;
q;
SQL
  SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/sqlplan.sec" \
    >"$home/sqlplan.log" 2>&1
  planRc=$?

  planFailed=0
  if [ "$planRc" -ne 0 ]; then
    echo "FAIL (planonly): client exited with $planRc"
    planFailed=1
  elif ! grep -q "Optimized plan:" "$home/sqlplan.log"; then
    echo "FAIL (planonly): no plan was reported"
    planFailed=1
  elif ! grep -q "Plan only" "$home/sqlplan.log"; then
    echo "FAIL (planonly): the plan was not reported as unexecuted"
    planFailed=1
  elif grep -q "Elem : 10" "$home/sqlplan.log"; then
    # The very output phase 4 requires -- here it means the plan ran anyway.
    echo "FAIL (planonly): the plan was executed despite the planonly flag"
    planFailed=1
  fi

  if [ "$planFailed" -ne 0 ]; then
    tail -30 "$home/sqlplan.log"
    rc=1
  else
    echo "OK (planonly): plan reported, query not executed"
  fi
fi

#
# Phase 7b: language routing. The client no longer decides which of the three
# input languages a typed command is written in -- it sends the auto command
# level and the server answers with the level it resolved to (SQLLanguage.h).
# So the routing itself is now a server behaviour, and this is where it is
# pinned down.
#
# Everything below is typed the way a user types it, with no prefix and no
# level. Two of them are traps: "delete database X" and "drop database X" begin
# with words the optimizer also uses ("delete from ...", "drop table ..."), and
# a rule that looks only at the first word hands them to the optimizer -- the
# user then gets "no plan found" or "no database is open; cannot use the
# optimizer" instead of being told that a database is still open.
#
# The save/restore pair is the other thing worth guarding: those two are
# carried out by the *client* (it holds the file), so the client has to keep
# recognizing them even though it no longer classifies anything else. They run
# on a database of their own, so the shared test database survives.
#
if [ "$sqlEnabled" -eq 1 ]; then
  echo "*** ClientServer test: language routing (server-side detection) ***"
  cat >"$home/route.sec" <<SQL
open database $DBNAME;
query ten feed count;
(list databases);
select * from ten;
showOptions;
delete database $DBNAME;
drop database $DBNAME;
save database to csdump;
close database;
restore database ${DBNAME}restored from csdump;
close database;
open database ${DBNAME}restored;
query ten feed count;
close database;
delete database ${DBNAME}restored;
q;
SQL
  SecondoCS -h 127.0.0.1 -p "$SEC_PORT" -i "$home/route.sec" \
    >"$home/route.log" 2>&1

  routeFailed=0
  if ! grep -qE "^10$" "$home/route.log"; then
    echo "FAIL (routing): a plain kernel command did not return its result"
    routeFailed=1
  elif ! grep -q "$(echo $DBNAME | tr a-z A-Z)" "$home/route.log"; then
    echo "FAIL (routing): a nested list command did not list the databases"
    routeFailed=1
  elif ! grep -q "Optimized plan:" "$home/route.log"; then
    echo "FAIL (routing): SQL was not recognized without a prefix"
    routeFailed=1
  elif ! grep -q "Elem : 10" "$home/route.log"; then
    echo "FAIL (routing): the optimized plan did not run"
    routeFailed=1
  elif ! grep -q "Optimizer options (and sub-options):" "$home/route.log"; then
    echo "FAIL (routing): a bare optimizer directive did not reach the optimizer"
    routeFailed=1
  elif ! grep -q "A database is open." "$home/route.log"; then
    echo "FAIL (routing): 'delete database' did not reach the kernel"
    routeFailed=1
  elif grep -qE "cannot use the optimizer|Optimization failed" "$home/route.log"; then
    echo "FAIL (routing): a kernel command was routed to the optimizer"
    routeFailed=1
  elif [ ! -f "$home/csdump" ]; then
    # The client writes this file itself; if it were sent to the server as an
    # ordinary command instead, no file would appear here.
    echo "FAIL (routing): 'save database' did not transfer the dump to the client"
    routeFailed=1
  elif [ "$(grep -cE "^10$" "$home/route.log")" -lt 2 ]; then
    echo "FAIL (routing): the restored database did not answer the query"
    routeFailed=1
  fi

  if [ "$routeFailed" -ne 0 ]; then
    grep -nE "cannot use the optimizer|Optimization failed|Error" \
         "$home/route.log" | head -5
    tail -30 "$home/route.log"
    rc=1
  else
    echo "OK (routing): each language reached the right interpreter"
  fi
fi

#
# Phase 8: graceful shutdown. Send the monitor a SIGTERM -- what a service
# manager or a CTRL+C does -- and assert the whole tree comes down cleanly:
#   * the monitor exits rather than hanging (it used to deadlock in BerkeleyDB
#     teardown run from its signal handler, roughly two shutdowns in three),
#   * no child is left orphaned (the reported symptom), and
#   * the registrar's unix socket is unlinked, which only happens if it unwound
#     through its destructor rather than being killed -- a precise oracle for
#     "the whole shutdown ran cleanly" (RC1b).
#
echo "*** ClientServer test: graceful shutdown ***"

regPrefix=$(grep -E "^[[:space:]]*RegistrarSocketNamePrefix" "$SECONDO_CONFIG" \
            2>/dev/null | head -1 | cut -d= -f2 | tr -d '[:space:]')
regSocket="/tmp/${regPrefix:-SECREGIS}_port${SEC_PORT}"

kids=$(descendants "$monPid" | tr '\n' ' ')
if [ ! -S "$regSocket" ]; then
  echo "FAIL (shutdown): registrar socket $regSocket missing before shutdown"
  rc=1
fi

# Note the checkpoint service now, while it is still running. It is the one
# daemon that lives inside Berkeley DB, so it is the one that can ignore the
# shutdown request by being blocked in there -- and the monitor kills it after
# 30s, destroying the evidence. Catching it mid-grace-period below is the only
# way to see the call it is stuck in.
#
# Matched on args, not comm: Linux truncates comm to 15 characters, and
# "SecondoCheckpoint" is 17, so a comm match silently never fires and the
# sampling below would quietly never happen.
cpPid=""
for pid in $kids; do
  case "$(ps -p "$pid" -o args= 2>/dev/null)" in
    *SecondoCheckpoint*) cpPid=$pid; break;;
  esac
done

# Wait well past the monitor's own worst case before calling it a deadlock.
shutdownWait=150
kill -TERM "$monPid" 2>/dev/null
shutdownGone=0
cpProbed=0
for i in $(seq 1 $((shutdownWait * 2))); do
  kill -0 "$monPid" 2>/dev/null || { shutdownGone=1; break; }
  # 15s in: past the point where a healthy checkpoint service has exited (it
  # polls its abort flag every 5s), and still well inside the monitor's 30s
  # grace period, so the process is alive to be sampled.
  if [ "$cpProbed" -eq 0 ] && [ "$i" -ge 30 ] && [ -n "$cpPid" ] \
     && kill -0 "$cpPid" 2>/dev/null; then
    cpProbed=1
    echo "NOTE (shutdown): checkpoint service $cpPid still alive 15s after" \
         "SIGTERM; sampling it before the monitor kills it"
    dump_backtrace "$cpPid" "checkpoint service"
  fi
  sleep 0.5
done
if [ "$shutdownGone" -ne 1 ]; then
  # Do not "wait" here: the monitor is still running, so it would block until
  # the harness times the whole test out an hour later, and this diagnostic --
  # the one written for exactly this case -- would never be printed. Report the
  # deadlock, dump what the monitor was doing, and kill the tree instead.
  echo "FAIL (shutdown): monitor still alive ${shutdownWait}s after SIGTERM" \
       "(deadlock?)"
  ps -p "$monPid" -o pid=,ppid=,stat=,comm= 2>/dev/null
  dump_backtrace "$monPid" "monitor"
  for pid in $kids; do
    if kill -0 "$pid" 2>/dev/null; then
      ps -p "$pid" -o pid=,ppid=,stat=,comm= 2>/dev/null
      # A surviving child is as interesting as the monitor: if it is the one
      # holding the region mutex the monitor is waiting for, its stack names
      # the Berkeley DB call that owns it.
      dump_backtrace "$pid" "monitor child"
    fi
  done
  echo "=== monitor log ==="
  tail -40 "$home/monitor.log"
  # Written by the checkpoint service to its cwd, which is bin/. It records the
  # environment it joined and any Berkeley DB error, so it is the other half of
  # the story whenever the checkpoint service is the one that got stuck.
  if [ -f "$buildDir/bin/Checkpoint.msg" ]; then
    echo "=== Checkpoint.msg ==="
    tail -40 "$buildDir/bin/Checkpoint.msg"
  fi
  kill -KILL "$monPid" 2>/dev/null
  for pid in $kids; do kill -KILL "$pid" 2>/dev/null; done
  wait "$monPid" 2>/dev/null
  rc=1
else
  wait "$monPid" 2>/dev/null
  assert_no_orphans "shutdown" $kids "$monPid" || rc=1
  if [ -e "$regSocket" ]; then
    echo "FAIL (shutdown): registrar socket $regSocket not removed"
    rc=1
  else
    echo "OK (shutdown): registrar socket removed"
  fi
  # The monitor exiting is not the whole story: a daemon that ignores the
  # shutdown request is now killed after its grace period, after which the
  # monitor exits cleanly, leaves no orphans and unlinks the socket.
  if grep -qE "had to be killed|could not be terminated" \
       "$home/monitor.log" 2>/dev/null; then
    echo "FAIL (shutdown): a daemon did not shut down on request:"
    grep -E "had to be killed|could not be terminated" "$home/monitor.log"
    # The daemon is gone by now, so its own log is what is left to go on.
    if [ -f "$buildDir/bin/Checkpoint.msg" ]; then
      echo "=== Checkpoint.msg ==="
      tail -40 "$buildDir/bin/Checkpoint.msg"
    fi
    rc=1
  else
    echo "OK (shutdown): all daemons shut down on request"
  fi
fi

#
# Phase 9: hard kill. A kill -9 of the monitor never runs Terminate(), so the
# only thing that can bring its children down is PR_SET_PDEATHSIG, armed in each
# child at spawn. Start a fresh monitor -- no clients needed, the registrar,
# checkpoint and listener are what must not be orphaned -- SIGKILL it, and
# assert the whole tree is reaped. On Linux this exercises PR_SET_PDEATHSIG; a
# platform without it would leave the children running and fail here, which is
# correct until the getppid watchdog lands.
#
echo "*** ClientServer test: hard kill (kill -9) orphan check ***"
pushd "$buildDir/bin" >/dev/null
SecondoMonitor -s -p "$SEC_PORT" >"$home/monitor2.log" 2>&1 &
monPid2=$!
popd >/dev/null
monPid=$monPid2   # let the cleanup trap reach this tree if we are interrupted
if ! wait_port "$SEC_PORT" 30; then
  echo "FAIL (kill9): monitor did not come up on port $SEC_PORT:"
  cat "$home/monitor2.log"; exit 1
fi
kids2=$(descendants "$monPid2" | tr '\n' ' ')
echo "    monitor pid $monPid2, children:$kids2"

kill -KILL "$monPid2" 2>/dev/null
wait "$monPid2" 2>/dev/null

# PR_SET_PDEATHSIG fires, then each child runs its own graceful shutdown, so
# give that a bounded window rather than asserting instantly.
kill9Gone=0
for _ in $(seq 1 20); do
  alive=""
  for pid in $kids2; do kill -0 "$pid" 2>/dev/null && alive="$alive $pid"; done
  [ -z "$alive" ] && { kill9Gone=1; break; }
  sleep 0.5
done
if [ "$kill9Gone" -eq 1 ]; then
  echo "OK (kill9): monitor children reaped after hard kill"
else
  assert_no_orphans "kill9" $kids2 || rc=1
  # Do not leak the orphans we just diagnosed.
  for pid in $kids2; do kill -KILL "$pid" 2>/dev/null; done
fi

exit $rc
