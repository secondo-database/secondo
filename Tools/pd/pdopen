#
# pdopen <file> - open a file with whatever viewer this system has.
#
# This is the default for PD_DVI_VIEWER and PD_PS_VIEWER. Picking the viewer
# here, when a file is actually opened, rather than when the environment is set
# up, is what lets the PD tools work on every platform with nothing exported.
# Set PD_DVI_VIEWER / PD_PS_VIEWER to override.

# xdg-open before open: on macOS "open" is the right tool and xdg-open does not
# exist, but on Linux /usr/bin/open is an alternatives symlink that is often
# util-linux's console switcher -- not a document viewer. Preferring xdg-open
# picks the correct one on both without having to ask uname.
for opener in xdg-open open evince okular gv; do
  if command -v "$opener" > /dev/null 2>&1; then
    exec "$opener" "$@"
  fi
done

echo "pdopen: no viewer found -- set PD_DVI_VIEWER or PD_PS_VIEWER" 1>&2
exit 1
